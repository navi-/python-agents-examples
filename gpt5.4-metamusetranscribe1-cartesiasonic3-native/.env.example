# OpenAI (LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Meta Model API (Muse Voice Transcribe STT)
META_API_KEY=
MUSE_MODEL=muse-voice-transcribe-1.0
# Realtime transcription session endpoint (OpenAI-compatible wire format, default shown)
# MUSE_REALTIME_URL=wss://api.meta.ai/v1/realtime
# g711_ulaw = forward Plivo u-law 8kHz untouched (default) | pcm16 = resample to 24kHz PCM16
MUSE_INPUT_FORMAT=g711_ulaw
# Leave empty for automatic language detection + mid-sentence code-switching
MUSE_LANGUAGE=
MUSE_DIARIZATION=true
MUSE_MAX_SPEAKERS=20
# Server endpointing silence (ms) before Muse finalises a turn
MUSE_ENDPOINT_SILENCE_MS=400
# Keyword biasing (comma separated; default = Babel + menu names, see inbound/agent.py).
# Learned speaker names are appended at runtime.
# MUSE_KEYWORDS=Babel,Bistro Mundo,paneer tikka
# Context biasing (free text describing the domain; default in inbound/agent.py)
# MUSE_CONTEXT=Restaurant phone line, several people ordering

# Cartesia (TTS)
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
CARTESIA_API_VERSION=2025-04-16
# Language used when the LLM reply carries no <xx> tag
CARTESIA_DEFAULT_LANGUAGE=en

# Plivo Credentials
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Plivo Phone Number (for auto-configuration)
# Supports any format: +1-234-567-8901, (234) 567-8901, 919880465079, etc.
PLIVO_PHONE_NUMBER=

# Second Plivo number used only for E2E tests (caller for inbound, destination for outbound)
# PLIVO_TEST_NUMBER=

# Default country code for phone numbers without country prefix (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY_CODE=US

# Public URL for webhooks (ngrok URL or production domain)
PUBLIC_URL=

# Server port
SERVER_PORT=8000

# Turn assembly tuning
# Merge consecutive Muse finals (e.g. two speakers back to back) within this window (ms)
TURN_DEBOUNCE_MS=300
# If Silero VAD hears silence but Muse never endpoints, commit partial text after this (ms)
MUSE_ENDPOINT_TIMEOUT_MS=1500

# Pipeline logging verbosity (verbose | normal | quiet)
# LOG_LEVEL=normal

# System prompt (leave empty to use inbound/system_prompt.md)
# SYSTEM_PROMPT=Your custom prompt here
